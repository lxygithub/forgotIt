# SQLite 数据库文件路径（prisma db push 时自动创建）
# 相对路径基于 prisma/schema.prisma 所在目录解析，仅适用于本地开发（bun run dev）
DATABASE_URL=file:../db/custom.db
#
# ⚠️ 生产部署（standalone）必须改用【绝对路径】，例如：
# DATABASE_URL=file:/var/lib/forgotit/custom.db
# 且初始化（bunx prisma db push）与启动服务时使用同一个值。
# 详见仓库根目录《forgotIt部署文档.md》§4.1/§4.2 与常见问题排查。
#
# 另：若 shell 中已 export DATABASE_URL，将覆盖本文件（dotenv 标准行为）。

# ————————————————————————————————————————————
# 单用户鉴权（NextAuth 方案 A，v1.2 起必需，缺省拒绝一切登录）
# ————————————————————————————————————————————
# 会话签名密钥：openssl rand -base64 32 生成（生产修改后需重新 build + 重启）
NEXTAUTH_SECRET=replace-with-random-base64-32
# 店主用户名
AUTH_USERNAME=owner
# 钥匙（密码）——二选一：
#   开发/快速体验用明文：
AUTH_PASSWORD=change-me-at-least-8-chars
#   生产推荐 scrypt 哈希（生成：bun run hash-password <你的密码>）：
# AUTH_PASSWORD_HASH=scrypt$...$...
# 生产部署还需（NextAuth 要求）：NEXTAUTH_URL=https://notes.example.com

# ————————————————————————————————————————————
# AI 凭证（可选，二选一：环境变量优先；缺省回落 .z-ai-config 文件，见部署文档 §5）
# Cloudflare Workers 部署无文件系统，必须用环境变量（wrangler secret put）
# ————————————————————————————————————————————
# ZAI_BASE_URL=https://...
# ZAI_API_KEY=...
# ZAI_TOKEN=...        # 可选：凭证含 token 时随请求头透传（与 SDK 行为一致）

# ————————————————————————————————————————————
# 双部署开关（仅 Cloudflare Workers 部署需要，见部署文档 §11；Node 部署无需理会）
# ————————————————————————————————————————————
# Cloudflare Workers 部署：Prisma 经 HTTPS 调用内网 SQL Gateway；此变量由 wrangler vars 配置。
# SQL_GATEWAY_URL=https://db-gateway.ieop.top/v1/query
# DB_DRIVER=gateway
# STORAGE_DRIVER=r2
