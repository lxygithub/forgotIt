// Cloudflare Workers 部署配置（双部署支持，v1.3）— 详见《forgotIt部署文档.md》§11
// 首次部署三步：
//   1) npx wrangler d1 create forgotit   → 把输出的 database_id 替换到下面
//   2) npx wrangler r2 bucket create forgotit-uploads
//   3) 按 §11 设置 secrets（NEXTAUTH_SECRET / AUTH_PASSWORD_HASH / ZAI_* 等）后 `bun run deploy:cf`
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forgotit",
  "main": "worker-wrapper.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // 2026-09-17：D1 库已删除（绑定留着会让 `wrangler deploy` 报 code 10181
  // 「references database ... which was not found」）。运行时数据一直在内网
  // PostgreSQL，经 SQL Gateway 访问；回退通道是下面的 Hyperdrive 绑定。
  // 顺带：vars 里的 DB_DRIVER 已无代码读取，@prisma/adapter-d1 依赖也已无引用。
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "forgotit-uploads"
    }
  ],
  // 数据库连接：Worker 通过 HTTPS 调用内网 SQL Gateway。WAF 仅放行本 Zone 的 Worker 子请求。
  // Hyperdrive binding 暂保留为回滚通道；SQL_GATEWAY_URL 存在时 src/lib/db.ts 优先使用 Gateway。
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "dbfd6840d76244dbb5419726644a01a4",
      // 占位值：wrangler 在本地/CI 初始化 proxy 时必须有一个连接串，否则
      // opennextjs-cloudflare deploy 会抛 "no local hyperdrive connection string"。
      // 线上部署只使用 Hyperdrive 远端的真实连接串，不读这里的值，所以占位即可
      // （也避免把真实密码写进仓库）。
      // 本地开发想连真库时，在 .env 里设
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://... 覆盖（环境变量优先）。
      "localConnectionString": "postgres://forgotit:placeholder@127.0.0.1:5432/forgotit"
    }
  ],
  "vars": {
    "DB_DRIVER": "gateway",
    "SQL_GATEWAY_URL": "https://db-gateway.ieop.top/v1/query",
    "STORAGE_DRIVER": "r2",
    // NextAuth 回调必须使用当前公开访问的自定义域。
    "NEXTAUTH_URL": "https://forgotit.ieop.top",
    "AUTH_USERNAME": "owner"
  },
  "observability": {
    "enabled": true
  }
}
