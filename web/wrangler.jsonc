// Cloudflare Workers 部署配置（双部署支持，v1.3）— 详见《forgotIt部署文档.md》§11
// 首次部署三步：
//   1) npx wrangler d1 create forgotit   → 把输出的 database_id 替换到下面
//   2) npx wrangler r2 bucket create forgotit-uploads
//   3) 按 §11 设置 secrets（NEXTAUTH_SECRET / AUTH_PASSWORD_HASH / ZAI_* 等）后 `bun run deploy:cf`
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forgotit",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // 把 bundle 目录内全部文件（含 Prisma wasm）上传为可通过 node:fs 读取的模块
  // find_additional_modules 已关闭：新生成器的 prisma wasm 走 ?module 静态导入（已打进 bundle），
  // 无需把整个 bundle 目录（含被 trace 误收的 1.3GB node_modules）上传为 fs 模块，且可避开 64MiB 限制
  // "find_additional_modules": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // 2026-09 迁移后 D1 已不再是主存储。此绑定暂时保留，作为回滚路径
  // （把 vars.DB_DRIVER 改回 "d1" 并还原 src/lib/db.ts 的 D1 分支即可切回）。
  // 线上稳定后，可连同 @prisma/adapter-d1 依赖一并移除。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forgotit",
      "database_id": "a34b542f-dbbb-4111-b5e9-38a26890660d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "forgotit-uploads"
    }
  ],
  // 【探针专用】仅用于验证 OpenNext 打包下 pg+Hyperdrive 是否可用；
  // 正式迁移时这里会取代 d1_databases
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "dbfd6840d76244dbb5419726644a01a4"
    }
  ],
  "vars": {
    // 2026-09：数据库已迁往自建 PostgreSQL（经 Hyperdrive），驱动开关由 d1 改为 pg。
    // 回滚：把 DB_DRIVER 改回 "d1" 并还原 src/lib/db.ts 的 D1 分支即可（d1_databases 绑定仍保留）。
    "DB_DRIVER": "pg",
    "STORAGE_DRIVER": "r2",
    // ⚠️ 替换为你的实际访问地址（如 https://forgotit.<account>.workers.dev 或自定义域）
    "NEXTAUTH_URL": "https://forgotit.mewlxyy666.workers.dev",
    "AUTH_USERNAME": "owner"
  },
  "observability": {
    "enabled": true
  }
}
