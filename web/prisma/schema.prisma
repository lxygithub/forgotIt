// 记不住 (ForgotIt) — 本地优先 AI 记事本
// Prisma schema 对应文档 v2.0 第 6.3 / 14.2 节数据模型（单用户本地版）

generator client {
  provider = "prisma-client-js"
  // driverAdapters：prisma-client-js 生成器（6.x）启用 D1 等驱动适配器所必需
  // （弃用警告无害；仅 Workers 部署用到适配器，Node 部署行为不变。见部署文档 §11）
  previewFeatures = ["driverAdapters", "queryCompiler"]
}

datasource db {
  // 2026-09 起从 SQLite(D1) 迁移到自建 PostgreSQL（经 Cloudflare Hyperdrive + Workers VPC 连接）
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 笔记
model Note {
  id        String       @id @default(cuid())
  type      String       @default("text") // text | image | mixed
  title     String?
  content   String? // Markdown 正文；纯文本视为不含语法的 Markdown
  summary   String? // AI 生成摘要（列表页展示）
  semanticKeywords String? // JSON string[]：LLM 语义关键词（同义词/相关概念，语义检索索引用）
  localOnly Boolean      @default(false) // 隐私标记：不走云端、不同步
  pinned    Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime? // 软删除（回收站，30 天）
  version   Int          @default(1) // 同步版本号（文档 6.5 LWW）
  tags      NoteTag[]
  attachments Attachment[]
  embeddings  Embedding[]
}

// 向量索引（文档 6.3 embeddings 表：记录 model_name / model_version，换模型后增量重索引）
// 原型用 SQLite 存 JSON 向量 + JS 余弦；生产环境换 PostgreSQL pgvector（vector(768) + HNSW）
model Embedding {
  id          String  @id @default(cuid())
  noteId      String
  note        Note    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  chunkIndex  Int     @default(0)
  modelName   String  // 原型：hash-ngram-zh-v1；生产：gemma-embedding-768
  modelVersion Int    @default(1)
  dim         Int
  vector      String // JSON number[]（L2 归一化后）
  updatedAt   DateTime @updatedAt

  @@unique([noteId, chunkIndex, modelName])
  @@index([modelName, modelVersion])
}

// 同步流水（文档 6.4 /sync/pull：按 seq 游标增量拉取）
model SyncLog {
  // seq 改由应用层分配（见 src/lib/sync-server.ts 的 logSyncInTx）。
  // 原因：PostgreSQL 的序列分配不参与事务 —— 事务 A 取到 seq=5、事务 B 取到 seq=6，
  // 若 B 先提交，pull 端读到 6 并把游标推过 5，A 提交后 seq=5 就永远不会被下发。
  // 现在改为在写事务里 UPDATE SyncCounter 取号（行锁保证分配序 == 提交序）。
  seq        Int      @id
  entityType String // note
  entityId   String
  op         String // upsert | delete
  deviceId   String?
  createdAt  DateTime @default(now())

  @@index([entityId])
}

// 同步序号计数器（单行表，id 恒为 1）
// 写入事务通过 UPDATE 这一行拿到行锁，从而把 seq 的分配串行化，
// 使「谁先拿到号」与「谁先提交」保持一致。
model SyncCounter {
  id    Int @id
  value Int @default(0)
}

// LWW 冲突快照（文档 6.5：落败方变更不丢弃，保留为版本快照供用户查看/恢复）
model ConflictSnapshot {
  id              String   @id @default(cuid())
  noteId          String
  losingDevice    String?
  losingPayload   String // JSON：落败方完整笔记内容
  losingUpdatedAt DateTime
  winnerUpdatedAt DateTime
  resolved        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([noteId])
}

// 标签（混合标签体系）
model Tag {
  id        String    @id @default(cuid())
  name      String
  kind      String // 'category'（固定类目树）| 'free'（AI/用户自由标签）
  parentId  String?
  color     String?
  createdAt DateTime  @default(now())
  notes     NoteTag[]

  @@unique([name, kind])
}

// 笔记-标签关联
model NoteTag {
  noteId  String
  tagId   String
  source  String // 'ai' | 'user'
  note    Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag     Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}

// 附件（图片等）
model Attachment {
  id          String   @id @default(cuid())
  noteId      String? // 可空：支持先上传图片、后建笔记的流程
  note        Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  filePath    String // 静态资源路径 /uploads/xxx.png
  thumbPath   String?
  mimeType    String
  size        Int      @default(0)
  width       Int?
  height      Int?
  description String? // VLM 图像描述（跨模态检索用）
  ocrText     String? // OCR 提取文本
  createdAt   DateTime @default(now())
}

// 同步墓碑（本地原型占位，后端同步用）
model Tombstone {
  id         String   @id @default(cuid())
  entityType String // note | tag | attachment
  entityId   String
  deletedAt  DateTime @default(now())
}

// 运行时键值配置（v1.4：前端「AI 模型配置」入口；单用户应用键值各一行）
// value 为 JSON 字符串，结构由调用方定义（ai 配置见 src/lib/settings.ts）
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}
